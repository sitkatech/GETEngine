 # script: transient_diversion_flow_other_decree.py (2019-02-08 15:40)
 # reference location: D:\kyledavis\01_Projects\nt00g43\Models\MODFLOW\00_HRB_gw_model\ancillary\scripts\diversions_other_decree\input\lut
