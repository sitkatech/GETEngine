 # Area of application for irrigation in Paradise Valley:  1,668,000,000 ft**2
 # determined from the feature class: LAND_IrrigatedArea_p (attribute IrrArea_50=1) in
 # Humboldt EGDB
 # Surface water withdrawals by decree in Paradise Valley from Martin Creek and Little
 # Humboldt, streams were summed and the inefficient portion was applied as recharge.
 # paradise_rch[ft/d] = rate[ft**3/s] / area[ft**2] * 86400[s/d])
 # Note: The inefficient factor is applied by multiplying a constant value in the model and the
 # full recharge values are listed in this file.
 #modelday	paradise_rch
 END OF RCH OPTIONS

 PROCESSING RCH DIMENSIONS
    MAXBOUND =     417
 END OF RCH DIMENSIONS

 RCH   -- RCH PACKAGE, VERSION 8, 2/22/2014 INPUT READ FROM UNIT 1014
 # RCH6 input file for the Middle Humboldt River Basin GW model
 # Recharge input representative of Gumboot Lake
 # each cell's rate is based on its contribution to a 2K, 4K, or 10K-acre sized lake
 # multiplier for calibration
 # time series
 # Time series file hrb_gumboot.rch6.ts defines recharge rates based on lake area
 # PRINT_INPUT
 # PRINT_FLOWS

 PROCESSING RCH OPTIONS
    FLOWS WILL BE SAVED TO BUDGET FILE SPECIFIED IN OUTPUT CONTROL
    AUXILIARY RCH VARIABLE: MULT            
    AUXILIARY MULTIPLIER NAME: MULT            
    RCH BOUNDARIES HAVE NAMES IN LAST COLUMN.
    TIME-SERIES DATA WILL BE READ FROM FILE: external_files/ts/hrb_rch6.gumboot.ts
 # time series for Gumboot Lake
 # rates based on area weighted recharge rate of 1.645E-5 ftd; 2K wgt = 0.5, 4K wgt = 0.6, 10K wgt = 0.8
 #day   	rate_2k	    rate_4k	    rate_10k
 END OF RCH OPTIONS

 PROCESSING RCH DIMENSIONS
    MAXBOUND =     135
 END OF RCH DIMENSIONS

